{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Coding Workflow Metrics Record",
  "type": "object",
  "required": [
    "schema_version", "timestamp", "task_id", "task_summary", "outcome",
    "initial_tier", "final_tier", "initial_score", "final_score", "dimensions",
    "semantic_red_flags", "required_gates", "delivery_profile",
    "capability_degradations", "changed_files", "changed_modules", "tests",
    "plan_review_rounds", "code_review_findings", "rework",
    "duration_minutes", "human_wait_minutes", "escaped_defect"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "timestamp": {"type": "string"},
    "task_id": {"type": "string", "minLength": 1},
    "task_summary": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["completed", "blocked"]},
    "initial_tier": {"enum": ["R1", "R2", "R3", "R4"]},
    "final_tier": {"enum": ["R1", "R2", "R3", "R4"]},
    "initial_score": {"type": "integer", "minimum": 0, "maximum": 36},
    "final_score": {"type": "integer", "minimum": 0, "maximum": 36},
    "dimensions": {
      "type": "object",
      "required": ["scope", "business", "code_impact", "architecture", "data", "infrastructure", "runtime_risk"],
      "additionalProperties": false,
      "properties": {
        "scope": {"type": "integer", "minimum": 0, "maximum": 3},
        "business": {"type": "integer", "minimum": 0, "maximum": 3},
        "code_impact": {"type": "integer", "minimum": 0, "maximum": 3},
        "architecture": {"type": "integer", "minimum": 0, "maximum": 3},
        "data": {"type": "integer", "minimum": 0, "maximum": 3},
        "infrastructure": {"type": "integer", "minimum": 0, "maximum": 3},
        "runtime_risk": {"type": "integer", "minimum": 0, "maximum": 3}
      }
    },
    "semantic_red_flags": {"type": "array", "items": {"type": "string"}},
    "required_gates": {"type": "array", "items": {"type": "string"}},
    "delivery_profile": {
      "type": "object",
      "required": ["agents", "worktrees", "rollout", "ownership"],
      "properties": {
        "agents": {"enum": ["1", "2+"]},
        "worktrees": {"enum": ["none", "optional", "required"]},
        "rollout": {"enum": ["none", "standard", "coordinated"]},
        "ownership": {"enum": ["single", "multi-team"]}
      }
    },
    "capability_degradations": {"type": "array", "items": {"type": "object"}},
    "reassessment_reasons": {"type": "array", "items": {"type": "string"}},
    "changed_files": {"type": "integer", "minimum": 0},
    "changed_modules": {"type": "integer", "minimum": 0},
    "tests": {"type": "array", "items": {"type": "object"}},
    "plan_review_rounds": {"type": "integer", "minimum": 0},
    "code_review_findings": {
      "type": "object",
      "required": ["critical", "high", "medium", "low"],
      "properties": {
        "critical": {"type": "integer", "minimum": 0},
        "high": {"type": "integer", "minimum": 0},
        "medium": {"type": "integer", "minimum": 0},
        "low": {"type": "integer", "minimum": 0}
      }
    },
    "rework": {"type": "boolean"},
    "duration_minutes": {"type": "integer", "minimum": 0},
    "human_wait_minutes": {"type": "integer", "minimum": 0},
    "escaped_defect": {"type": ["boolean", "null"]}
  }
}
